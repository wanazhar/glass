{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glass-browser.dev/schema/glass-extension-v1.schema.json",
  "title": "Glass extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "apiVersion", "capabilities", "permissions", "entrypoint"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "version": {"type": "string", "minLength": 1, "maxLength": 256},
    "apiVersion": {"type": "integer", "minimum": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"enum": ["customVerification", "semanticRegionClassifier", "intentEvidencePack", "extractionTransform", "siteAdapter", "workflowTemplate", "traceExporter", "knowledgeStore", "strictPolicy"]}
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts", "actions"],
      "properties": {
        "hosts": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[^*/]+$"}},
        "actions": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"enum": ["navigate", "observe", "verify", "click", "type", "clear", "check", "uncheck", "select", "scroll", "extract"]}}
      }
    },
    "entrypoint": {"type": ["string", "null"], "maxLength": 256}
  }
}
