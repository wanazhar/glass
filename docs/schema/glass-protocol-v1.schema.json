{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glass-browser.dev/schema/glass-protocol-v1.schema.json",
  "title": "Glass transport-neutral protocol envelope",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/response"}
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "token"],
      "properties": {
        "sessionId": {"$ref": "#/$defs/identifier"},
        "token": {"$ref": "#/$defs/identifier"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 64},
        "message": {"type": "string", "minLength": 1, "maxLength": 512},
        "retryable": {"type": "boolean"},
        "details": {}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "operation", "payload"],
      "properties": {
        "protocolVersion": {"const": 1},
        "requestId": {"$ref": "#/$defs/identifier"},
        "correlationId": {"$ref": "#/$defs/identifier"},
        "sessionId": {"$ref": "#/$defs/identifier"},
        "mutationLease": {"$ref": "#/$defs/lease"},
        "operation": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^\\S+$"},
        "payload": {},
        "deadlineMs": {"type": "integer", "minimum": 1, "maximum": 900000}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "ok"],
      "properties": {
        "protocolVersion": {"const": 1},
        "requestId": {"$ref": "#/$defs/identifier"},
        "correlationId": {"$ref": "#/$defs/identifier"},
        "ok": {"type": "boolean"},
        "result": {},
        "error": {"$ref": "#/$defs/error"}
      },
      "oneOf": [
        {"required": ["result"], "not": {"required": ["error"]}},
        {"required": ["error"], "not": {"required": ["result"]}}
      ]
    }
  }
}
