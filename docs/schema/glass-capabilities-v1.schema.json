{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glass-browser.dev/schema/glass-capabilities-v1.schema.json",
  "title": "Glass capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "glassVersion", "schemas", "capabilities", "constraints"],
  "properties": {
    "protocolVersion": {"const": 1},
    "glassVersion": {"type": "string", "minLength": 1, "maxLength": 128},
    "schemas": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "uniqueItems": true,
        "items": {"type": "integer", "minimum": 1}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "browserFamily", "policy", "maxSessions"],
      "properties": {
        "platform": {"type": "string", "minLength": 1, "maxLength": 64},
        "browserFamily": {"const": "chromium"},
        "policy": {"type": "string", "minLength": 1, "maxLength": 32},
        "maxSessions": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    }
  }
}
