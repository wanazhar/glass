{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glass-browser.dev/schema/glass-daemon-v1.schema.json",
  "title": "Glass local daemon status",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "state", "pid", "socket", "statusPath", "startedAt", "transport", "clientSessions"],
  "properties": {
    "protocolVersion": {"const": 1},
    "state": {"enum": ["running", "stopped"]},
    "pid": {"type": "integer", "minimum": 1},
    "socket": {"type": "string", "minLength": 1, "maxLength": 4096},
    "statusPath": {"type": "string", "minLength": 1, "maxLength": 4096},
    "logPath": {"type": "string", "minLength": 1, "maxLength": 4096},
    "recoveryPath": {"type": "string", "minLength": 1, "maxLength": 4096},
    "startedAt": {"type": "string", "minLength": 1, "maxLength": 64},
    "transport": {"const": "unix-mcp-shared-session"},
    "clientSessions": {"type": "integer", "minimum": 0, "maximum": 64},
    "mutationLeaseOwner": {"type": "string", "minLength": 1, "maxLength": 128},
    "activeRuns": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "ownerId", "startedAt"],
        "properties": {
          "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
          "ownerId": {"type": "string", "minLength": 1, "maxLength": 128},
          "startedAt": {"type": "string", "minLength": 1, "maxLength": 64}
        }
      }
    }
  }
}
