{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glass-browser.dev/schema/glass-daemon-recovery-v1.schema.json",
  "title": "Glass daemon interrupted workflow recovery",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "state", "recoveredAt", "runs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "state": {"const": "reconciliation_required"},
    "recoveredAt": {"type": "string", "minLength": 1, "maxLength": 64},
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "ownerId", "startedAt"],
        "properties": {
          "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
          "ownerId": {"type": "string", "minLength": 1, "maxLength": 128},
          "startedAt": {"type": "string", "minLength": 1, "maxLength": 64}
        }
      }
    }
  }
}
