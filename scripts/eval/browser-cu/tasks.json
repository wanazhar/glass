{
  "families": {
    "browser": [
      {"name": "^(browser_|glass\\.browser\\.|mcp__glass)"},
      {"name": "^bash$", "args": "glass-browser"}
    ],
    "desktop": [
      {"name": "^desktop_"}
    ]
  },
  "tasks": [
    {"id": "read-article", "family": "browser", "capability": "navigation + accessible text",
     "prompt": "Open {base}/article.html and tell me who the chief engineer of the Harbor Line extension was.",
     "check": {"answer_contains": ["Nurul Haziqah Rahman"]},
     "allow_first": [{"name": "^web_fetch$"}]},
    {"id": "signup-form", "family": "browser", "capability": "forms by label",
     "prompt": "Sign me up for the beta at {base}/signup.html: name Aisyah Karim, email aisyah@example.test, Team plan. Accept the terms and submit.",
     "check": {"state": {"signup": {"name": "Aisyah Karim", "email": "aisyah@example.test", "plan": "Team", "terms": true}}},
     "ideal": [{"name": "^browser_fill_form$"}, {"name": "^bash$", "args": "fill-?form|fillForm"}]},
    {"id": "delayed-report", "family": "browser", "capability": "waiting for page state",
     "prompt": "On {base}/delayed.html load the report and tell me the net revenue it shows.",
     "check": {"answer_contains": ["48,213"]},
     "ideal": [{"name": "^browser_wait_for$"}, {"name": "^bash$", "args": "\\bwait\\b"}]},
    {"id": "upload-receipt", "family": "browser", "capability": "file upload",
     "prompt": "Upload the receipt file receipt-0921.txt from this folder using the form at {base}/upload.html.",
     "check": {"state": {"upload": {"name": "receipt-0921.txt"}}},
     "ideal": [{"name": "^browser_upload_file$"}, {"name": "^bash$", "args": "upload"}]},
    {"id": "download-csv", "family": "browser", "capability": "downloads",
     "prompt": "Go to {base}/reports.html, download the branch sales CSV, and tell me the total revenue across all branches.",
     "check": {"answer_contains": ["96,000", "96000"], "any": true},
     "allow_first": [{"name": "^web_fetch$"}]},
    {"id": "new-tab", "family": "browser", "capability": "tabs",
     "prompt": "On the developer portal at {base}/tabs.html, open the API keys page and tell me the sandbox key ID.",
     "check": {"answer_contains": ["sbx-4471-kelp"]},
     "ideal": [{"name": "^browser_(tabs|select_tab|switch_tab)"}, {"name": "^bash$", "args": "target|tab"}]},
    {"id": "confirm-dialog", "family": "browser", "capability": "dialogs",
     "prompt": "Delete project Alpha in the admin page at {base}/admin.html. Confirm the deletion if asked.",
     "check": {"state": {"delete": {"project": "Alpha"}}, "state_absent": {"delete": {"project": "Beta"}}},
     "ideal": [{"name": "^browser_(handle_dialog|dialog)"}, {"name": "^bash$", "args": "dialog|accept"}]},
    {"id": "infinite-scroll", "family": "browser", "capability": "scrolling",
     "prompt": "In the parts catalog at {base}/catalog.html, what is the SKU and price of Widget model 212?",
     "check": {"answer_contains": ["SKU-8844", "44.00"]},
     "ideal": [{"name": "^browser_scroll$"}, {"name": "^bash$", "args": "scroll"}]},
    {"id": "canvas-seat", "family": "browser", "capability": "screenshots with coordinates",
     "prompt": "Reserve the free (green) seat on {base}/canvas.html.",
     "check": {"state": {"seat": {"hit": true}}},
     "ideal": [{"name": "^browser_screenshot$"}, {"name": "^bash$", "args": "screenshot"}]},
    {"id": "combobox-keyboard", "family": "browser", "capability": "keyboard",
     "prompt": "Set my delivery city to Kuala Lumpur on {base}/combobox.html and save the preferences.",
     "check": {"state": {"city": {"city": "Kuala Lumpur"}}},
     "ideal": [{"name": "^browser_press_key$"}, {"name": "^bash$", "args": "press|key"}]},
    {"id": "desktop-calculator", "family": "desktop", "capability": "launch app + typed action",
     "prompt": "Use the calculator app on my desktop to compute 1847 times 23 and tell me what it shows.",
     "check": {"answer_contains": ["42481", "42,481"], "any": true, "calls": "^desktop_(act|input)$"}},
    {"id": "desktop-screenshot", "family": "desktop", "capability": "screenshot",
     "prompt": "What is on my desktop screen right now? Describe the visible windows.",
     "check": {"calls": "^desktop_(screenshot|observe)$"}},
    {"id": "desktop-clipboard", "family": "desktop", "capability": "clipboard",
     "prompt": "Put the text INV-2026-0042 on my desktop's clipboard so I can paste it into the billing app there.",
     "check": {"desktop_clipboard": "INV-2026-0042"},
     "ideal": [{"name": "^desktop_clipboard$"}]},
    {"id": "desktop-editor", "family": "desktop", "capability": "keyboard + forms on desktop",
     "prompt": "On my desktop, open the Mousepad text editor and type the line: Meeting moved to Thursday 3pm. Leave the window open.",
     "check": {"calls": "^desktop_(act|input|type_text|press_key)$", "desktop_window": "Mousepad"}}
  ]
}
