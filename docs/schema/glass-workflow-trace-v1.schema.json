{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glass-browser.dev/schema/glass-workflow-trace-v1.schema.json",
  "title": "Glass workflow trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "events"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "maxLength": 128},
    "events": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "stepId", "state", "attempt"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "stepId": {"type": "string", "minLength": 1, "maxLength": 128},
          "state": {"type": "string", "minLength": 1, "maxLength": 64},
          "attempt": {"type": "integer", "minimum": 0}
        }
      }
    },
    "branchDecisions": {"type": "array", "maxItems": 64, "items": {"type": "object"}},
    "intentResolutions": {"type": "array", "maxItems": 64, "items": {"type": "object"}}
  }
}
