# Optional local Cargo config for faster incremental builds.
# Copy the sections you want into ~/.cargo/config.toml, or
# `mkdir -p .cargo && cp scripts/cargo-config.local.toml.example .cargo/config.toml`
# in a checkout. Do not commit a machine-specific `.cargo/config.toml`.
#
# mold: faster linking on Linux. Requires the `mold` linker on PATH.
# sccache is enabled per-shell with:
#   export RUSTC_WRAPPER=sccache
#   export SCCACHE_CACHE_SIZE=5G
#   export SCCACHE_DIR="$HOME/.cache/sccache"
# scripts/ci-local.sh sets the sccache variables when sccache is installed.

[target.x86_64-unknown-linux-gnu]
rustflags = ["-C", "link-arg=-fuse-ld=mold"]

[target.aarch64-unknown-linux-gnu]
rustflags = ["-C", "link-arg=-fuse-ld=mold"]
