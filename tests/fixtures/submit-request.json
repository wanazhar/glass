{
  "schemaVersion": 1,
  "name": "submit-request",
  "workflowVersion": "1.0.0",
  "inputs": {},
  "budgets": {
    "maxSteps": 1,
    "maxDurationMs": 30000,
    "maxRetries": 0,
    "maxExtractedBytes": 4096
  },
  "steps": [
    {
      "id": "submit",
      "intent": {
        "action": "submit",
        "purpose": "submit request",
        "scope": {"regionKind": "main"},
        "constraints": {"role": "button", "name": "Submit request", "maxCandidates": 8},
        "resolutionPolicy": "requireUniqueHighConfidence"
      },
      "transaction": "non_idempotent",
      "idempotencyKey": "reliability-submit-once",
      "maxRetries": 0,
      "repeat": 1
    }
  ],
  "terminalCondition": {"visible": "css=#target"},
  "outputs": {}
}
