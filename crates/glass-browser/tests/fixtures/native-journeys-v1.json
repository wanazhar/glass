{
  "schemaVersion": 1,
  "corpus": "glass-browser-native-journeys",
  "privacy": "authored fixtures only; public journeys are read-only and retain no page dumps",
  "journeys": [
    {
      "id": "local-navigation-and-nested-scroll",
      "backend": "native",
      "scope": "local-fixture",
      "capabilities": ["navigation", "semantic-targeting", "history", "nested-scroll"],
      "timeoutMs": 10000,
      "steps": [
        {"id":"landing","action":"navigate","url":"fixture://journey.test/"},
        {"id":"choose-detail","action":"click","target":"id=detail-link","targetSource":"fresh-observation"},
        {"id":"detail-content","action":"assert","expression":"document.title === 'Journey detail' && document.querySelector('#detail').textContent.includes('Detail')"},
        {"id":"history-back","action":"back"},
        {"id":"history-forward","action":"forward"},
        {"id":"observe-feed","action":"observe"},
        {"id":"select-scroller","action":"scrollTargetObserved","nameContains":"Feed","tagName":"div","targetSource":"fresh-observation","dy":28},
        {"id":"verify-scroller","action":"assert","expression":"document.querySelector('#feed').scrollTop === 28"}
      ]
    },
    {
      "id": "local-image-gallery-full-view",
      "backend": "native",
      "scope": "local-fixture",
      "capabilities": ["navigation", "image-fetch", "image-decode", "image-dimensions", "paint", "capture"],
      "timeoutMs": 10000,
      "steps": [
        {"id":"gallery","action":"navigate","url":"fixture://journey-images.test/gallery"},
        {"id":"assert-thumbnail","action":"assert","expression":"document.title === 'Journey gallery' && document.querySelector('#thumbnail').complete && document.querySelector('#thumbnail').naturalWidth === 2"},
        {"id":"open-observed-image","action":"click","target":"id=full-image-link","targetSource":"fresh-observation"},
        {"id":"assert-full-image","action":"assert","expression":"document.title === 'Full image' && document.querySelector('#full-image').complete && document.querySelector('#full-image').naturalWidth === 2 && document.querySelector('#full-image').naturalHeight === 2"},
        {"id":"capture-full-image","action":"capture","assertion":"raster contains decoded image pixels"}
      ]
    },
    {
      "id": "local-disclosure-search-and-results",
      "backend": "native",
      "scope": "local-fixture",
      "capabilities": ["navigation", "disclosure", "form-input", "search", "history"],
      "timeoutMs": 10000,
      "steps": [
        {"id":"search-page","action":"navigate","url":"fixture://journey-search.test/"},
        {"id":"open-disclosure","action":"click","target":"id=help-toggle","targetSource":"fresh-observation"},
        {"id":"assert-disclosure","action":"assert","expression":"document.querySelector('#help-toggle').getAttribute('aria-expanded') === 'true' && !document.querySelector('#help-answer').hidden && document.querySelector('#help-answer').textContent.includes('search')"},
        {"id":"enter-query","action":"type","target":"id=query","targetSource":"fresh-observation","text":"rust"},
        {"id":"submit-search","action":"click","target":"id=search-submit","targetSource":"fresh-observation"},
        {"id":"assert-result","action":"assert","expression":"document.title === 'Search results' && document.querySelector('#result').textContent.includes('Rust') && location.search === '?q=rust'"},
        {"id":"return-to-search","action":"back"},
        {"id":"assert-search-history","action":"assert","expression":"document.title === 'Search' && location.search === ''"}
      ]
    },
    {
      "id": "local-responsive-duplicate-link",
      "backend": "native",
      "scope": "local-fixture",
      "capabilities": ["navigation", "semantic-targeting", "responsive-duplicate-controls"],
      "timeoutMs": 10000,
      "steps": [
        {"id":"repository-fixture","action":"navigate","url":"fixture://journey-responsive.test/"},
        {"id":"choose-large-screen-library-link","action":"clickObserved","role":"link","nameContains":"library","targetSource":"fresh-observation"},
        {"id":"assert-library-page","action":"assert","expression":"document.title === 'Rust library' && document.querySelector('#core').textContent.includes('Core library')"}
      ]
    },
    {
      "id": "local-repository-shadow-directory-slots",
      "backend": "native",
      "scope": "local-fixture",
      "capabilities": ["navigation", "shadow-dom", "slot-assignment", "slot-mutation", "semantic-targeting"],
      "timeoutMs": 10000,
      "steps": [
        {"id":"repository-tree","action":"navigate","url":"fixture://journey-shadow-repository.test/"},
        {"id":"assert-first-slot-assignment","action":"assert","expression":"Array.from(document.querySelector('x-repository-tree').shadowRoot.querySelectorAll('slot')).filter(slot => slot.getAttribute('name') === 'directory').length === 2 && document.querySelector('#library-link').getAttribute('slot') === 'directory'"},
        {"id":"remove-library-assignment","action":"evaluate","expression":"document.querySelector('#library-link').setAttribute('slot', 'unassigned')"},
        {"id":"observe-without-assignment","action":"observe"},
        {"id":"restore-library-assignment","action":"evaluate","expression":"document.querySelector('#library-link').setAttribute('slot', 'directory')"},
        {"id":"observe-restored-assignment","action":"observe"},
        {"id":"open-observed-library","action":"clickObserved","role":"link","nameEquals":"library","targetSource":"fresh-observation"},
        {"id":"assert-directory","action":"assert","expression":"location.pathname === '/library' && document.title === 'Rust library'"}
      ]
    },
    {
      "id": "public-documentation-deep-page",
      "backend": "native",
      "scope": "public-read-only",
      "capabilities": ["navigation", "observation", "semantic-targeting"],
      "timeoutMs": 120000,
      "steps": [
        {"id":"reference","action":"navigate","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/map"},
        {"id":"observe-reference","action":"observe"},
        {"id":"assert-reference","action":"assert","condition":"url-prefix=https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/map"}
      ]
    },
    {
      "id": "public-wikipedia-article-and-observed-subpage",
      "backend": "native",
      "scope": "public-read-only",
      "capabilities": ["navigation", "observation", "semantic-targeting", "subpage-navigation"],
      "timeoutMs": 120000,
      "runnerTimeoutMs": 360000,
      "steps": [
        {"id":"article","action":"navigate","url":"https://en.wikipedia.org/wiki/Computer"},
        {"id":"observe-article","action":"observe"},
        {"id":"assert-article-identity","action":"assert","condition":"title-contains=Computer"},
        {"id":"choose-observed-subpage","action":"clickObserved","role":"link","nameEquals":"Computer science","targetSource":"fresh-observation"},
        {"id":"observe-subpage","action":"observe"},
        {"id":"assert-subpage","action":"assert","condition":"url-prefix=https://en.wikipedia.org/wiki/Computer_science"},
        {"id":"assert-subpage-identity","action":"assert","condition":"title-contains=Computer science"}
      ]
    },
    {
      "id": "public-svelte-documentation-page-scroll",
      "backend": "native",
      "scope": "public-read-only",
      "capabilities": ["navigation", "observation", "page-scroll"],
      "timeoutMs": 120000,
      "steps": [
        {"id":"docs-page","action":"navigate","url":"https://svelte.dev/docs/svelte/svelte-reactivity"},
        {"id":"observe-docs","action":"observe"},
        {"id":"assert-docs-content","action":"assert","condition":"title-contains=reactivity"},
        {"id":"observe-viewport-before-scroll","action":"observe"},
        {"id":"scroll-page","action":"scroll","targetSource":"observed-viewport","dy":400},
        {"id":"observe-after-scroll","action":"observe"}
      ]
    },
    {
      "id": "public-github-repository-and-observed-directory",
      "backend": "native",
      "scope": "public-read-only",
      "capabilities": ["navigation", "observation", "semantic-targeting", "subpage-navigation", "repository-content"],
      "timeoutMs": 120000,
      "steps": [
        {"id":"repository","action":"navigate","url":"https://github.com/rust-lang/rust"},
        {"id":"observe-repository","action":"observe"},
        {"id":"assert-repository-content","action":"assert","expression":"document.title.toLowerCase().includes('rust') && document.body.innerText.includes('rust-lang/rust')"},
        {"id":"open-observed-library","action":"clickObserved","role":"link","nameContains":"library","targetSource":"fresh-observation"},
        {"id":"observe-library","action":"observe"},
        {"id":"assert-library-content","action":"assert","expression":"location.pathname === '/rust-lang/rust/tree/main/library' && document.body.innerText.toLowerCase().includes('core')"}
      ]
    },
    {
      "id": "public-mdn-cc0-webm-playback",
      "backend": "native",
      "scope": "public-read-only",
      "capabilities": ["video/webm", "vp8-decode", "decoded-dimensions", "playback-clock", "pause", "screenshot"],
      "asset": {
        "url": "https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.webm",
        "license": "CC0-1.0",
        "sourcePage": "https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/video"
      },
      "timeoutMs": 30000,
      "runnerTimeoutMs": 90000,
      "steps": [
        {"id":"video-demo","action":"navigate","url":"https://interactive-examples.mdn.mozilla.net/pages/tabbed/video.html"},
        {"id":"observe-demo","action":"observe"},
        {"id":"assert-video-resource","action":"assert","timeoutMs":15000,"expression":"(() => { const video = document.querySelector('video'); return !!video && video.currentSrc.includes('flower.webm') && video.readyState >= 2 && video.videoWidth > 0 && video.videoHeight > 0 && video.duration > 0; })()"},
        {"id":"play-muted-video","action":"evaluate","expression":"(() => { const video = document.querySelector('video'); if (!video || !video.currentSrc.includes('flower.webm')) throw new Error('expected observed MDN WebM sample'); video.muted = true; video.play(); return true; })()"},
        {"id":"verify-decoded-playback-progress","action":"assert","timeoutMs":10000,"expression":"(() => { const video = document.querySelector('video'); return !!video && !video.paused && video.currentTime >= 0.25 && video.videoWidth > 0 && video.videoHeight > 0; })()"},
        {"id":"pause-video","action":"evaluate","expression":"(() => { const video = document.querySelector('video'); if (!video) throw new Error('video element disappeared'); video.pause(); return video.paused; })()"},
        {"id":"verify-paused-playback","action":"assert","expression":"(() => { const video = document.querySelector('video'); return !!video && video.paused && video.currentTime >= 0.25; })()"},
        {"id":"capture-rendered-video","action":"screenshot"}
      ]
    },
    {
      "id": "local-audio-wav-decode-and-client-playback",
      "backend": "native",
      "scope": "local-fixture",
      "capabilities": ["wav-pcm-decode", "client-audio-artifact", "user-controlled-playback"],
      "timeoutMs": 10000,
      "asset": {"kind":"authored-sine-wave","sampleRateHz":8000,"channels":1,"durationMs":250,"license":"CC0-1.0"},
      "expectedCapability": "supported-as-wav-artifact",
      "requiresSoundDevice": false,
      "steps": [
        {"id":"probe-wav","action":"capability","type":"audio/wav","expected":"maybe"},
        {"id":"decode-pcm","action":"assert","expression":"audio.readyState === 2 && audio.duration === 0.25"},
        {"id":"check-samples","action":"assertDecodedAudio","format":"pcm_s16le","channels":1,"sampleRateHz":8000,"durationMs":250,"requireNonSilentSamples":true},
        {"id":"publish-client-artifact","action":"publishAudioArtifact","format":"audio/wav","userControlled":true,"autoplay":false},
        {"id":"listen-from-client","action":"playFromRemoteView","assertion":"decoded sine-wave samples are delivered to the user's client audio output"}
      ]
    },
    {
      "id": "local-silent-video-webm-vp8-playback",
      "backend": "native",
      "scope": "local-fixture",
      "capabilities": ["webm-demux", "vp8-decode", "silent-video", "playback-clock", "pause", "seek", "paint"],
      "asset": "tests/fixtures/native-media/two-color-frames-vp8.webm",
      "expectedCapability": "supported",
      "expectedDurationSeconds": 1,
      "seekSeconds": 0.75,
      "playbackWaitMs": 650,
      "expectedFrameColor": "blue",
      "steps": [
        {"id":"probe-vp8-decoder","action":"capability","type":"video/webm; codecs=\"vp8\"","expected":"maybe"},
        {"id":"admit-video","action":"assert","readyState":2,"durationSeconds":1},
        {"id":"seek","action":"seek","timeSeconds":0.75},
        {"id":"rewind","action":"seek","timeSeconds":0},
        {"id":"play","action":"play"},
        {"id":"advance-clock","action":"wait","durationMs":650},
        {"id":"pause","action":"pause"},
        {"id":"verify-frame","action":"capture","frameColor":"blue"}
      ]
    }
  ]
}
