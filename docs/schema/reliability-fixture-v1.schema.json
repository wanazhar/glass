{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glass-browser.dev/schema/reliability-fixture-v1.schema.json",
  "title": "Glass reliability fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "entrypoint", "controls", "faults", "oracles"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "entrypoint": {"type": "string", "minLength": 1, "maxLength": 256},
    "controls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["reset", "replaceTarget", "renameTarget", "duplicateTarget", "moveTargetToOtherRegion", "showOverlay", "moveTarget", "detachFrame", "scheduleEffectMarker", "commitSubmit"]}
    },
    "faults": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["loseResponse", "rendererDisconnect", "browserDisconnect", "delayedEffect", "dropEvent"]}
    },
    "oracles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["snapshot", "submitSideEffectCount"]}
    }
  }
}
