{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glass-browser.dev/schema/reliability-scenario-v1.schema.json",
  "title": "Glass reliability scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "category", "fixture", "platforms", "setup", "steps", "expect", "forbid", "budgets"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "category": {"type": "string", "minLength": 1, "maxLength": 128},
    "fixture": {"type": "string", "minLength": 1, "maxLength": 256},
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["linux-x86-64", "macos-x86-64", "macos-arm64"]}
    },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "policy"],
      "properties": {
        "browser": {"type": "string", "minLength": 1, "maxLength": 128},
        "policy": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "maxProperties": 1,
        "oneOf": [
          {"required": ["runWorkflow"], "properties": {"runWorkflow": {"type": "string", "minLength": 1, "maxLength": 256}}},
          {"required": ["applyControl"], "properties": {"applyControl": {"enum": ["reset", "replaceTarget", "renameTarget", "duplicateTarget", "moveTargetToOtherRegion", "showOverlay", "moveTarget", "detachFrame", "scheduleEffectMarker", "commitSubmit"]}}},
          {"required": ["inject"], "properties": {"inject": {"$ref": "#/$defs/injection"}}},
          {"required": ["resumeFromCheckpoint"], "properties": {"resumeFromCheckpoint": {"type": "string", "minLength": 1, "maxLength": 256}}}
        ]
      }
    },
    "expect": {"$ref": "#/$defs/expectation"},
    "forbid": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {"enum": ["wrongTargetExecuted", "staleRevisionExecuted", "ambiguousTargetSilentlyExecuted", "nonIdempotentMutationDuplicated", "falseWorkflowCompletion", "unsafeResumeReplay", "secretLeaked", "crossProfileKnowledgeLeak", "unboundedLoopEscapedBudget", "policyBypassed", "checkpointAcceptedAfterIncompatibleDefinitionChange", "semanticCacheHidCriticalUnexpectedState"]}
    },
    "budgets": {"$ref": "#/$defs/budgets"}
  },
  "$defs": {
    "injection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["afterDispatch", "fault"],
      "properties": {
        "afterDispatch": {"type": "string", "minLength": 1, "maxLength": 128},
        "fault": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminalState"],
      "properties": {
        "terminalState": {"type": "string", "minLength": 1, "maxLength": 128},
        "sideEffectCount": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 1024}
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDurationMs", "maxBrowserActions"],
      "properties": {
        "maxDurationMs": {"type": "integer", "minimum": 1, "maximum": 900000},
        "maxBrowserActions": {"type": "integer", "minimum": 1, "maximum": 1024}
      }
    }
  }
}
